# Copy to .env; formats and storage setup: ../docs/CONFIGURATION.md
BASE_DOMAIN=example.com
TZ=Europe/Sofia

PUID=1000
PGID=1000

DATA_PATH=/srv/data

PAPERLESS_DB_PASSWORD=STRONG_PASSWORD
# Generate once: openssl rand -hex 32; keep the original key on existing installs.
PAPERLESS_SECRET_KEY=STRONG_KEY
