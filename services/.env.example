# Copy to .env; formats and storage setup: ../docs/CONFIGURATION.md
PUID=1000
PGID=1000
TZ=Europe/Sofia
BASE_DOMAIN=example.com

# Generate once: openssl rand -base64 32
HOMEPAGE_AUTH_SECRET=STRONG_SECRET
# Plain password, not a bcrypt hash.
HOMEPAGE_AUTH_PASSWORD=STRONG_PASSWORD

# Credentials/API tokens for the widgets enabled in homepage/config/.
ADGUARD_USERNAME=NICE_USERNAME
ADGUARD_PASSWORD=STRONG_PASSWORD

JELLYFIN_API_KEY=API_KEY
# Issued by Speedtest Tracker; distinct from infrastructure's SPEEDTEST_APP_KEY.
SPEEDTEST_API_KEY=API_KEY
IMMICH_API_KEY=API_KEY

PERSONAL_CALENDAR_URL=CALENDAR_URL
WORK_CALENDAR_URL=CALENDAR_URL
BG_HOLIDAYS_CALENDAR_URL=CALENDAR_URL
BIRTHDAYS_CALENDAR_URL=CALENDAR_URL
MEDICAL_CALENDAR_URL=CALENDAR_URL

QBITTORRENT_USERNAME=NICE_USERNAME
QBITTORRENT_PASSWORD=STRONG_PASSWORD

# Generate once: openssl rand -hex 32
OVUMCY_SECRET_KEY=SECRET
# Comma-separated Caddy source IPs/CIDRs on homelab-edge; see configuration guide.
OVUMCY_TRUSTED_PROXIES=PROXIES

ZIMS_PATH=/srv/data/zimi
ZIMI_MANAGE_USER=NICE_USERNAME
ZIMI_MANAGE_PASSWORD=STRONG_PASSWORD

DATA_PATH=/srv/data
MOVIES_PATH=/srv/media/movies
TVSHOWS_PATH=/srv/media/tvshows

# For a fresh database, use URI-safe hex: openssl rand -hex 32
DVINYL_DB_PASSWORD=STRONG_PASSWORD
# Two different random values; generate each with openssl rand -hex 32.
DVINYL_PASSJWT=STRONG_PASSWORD
DVINYL_SESSION_SECRET=SECRET
# Obtain from your Discogs account; do not generate a random replacement.
DVINYL_DISCOGS_TOKEN=PERSONAL_TOKEN
