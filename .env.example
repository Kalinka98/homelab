PUID=1000
PGID=1000
TZ=Europe/Sofia
DOWNLOADS_PATH=C:\Downloads
MOVIES_PATH=C:\Movies
TVSHOWS_PATH=C:\TV Shows

# Public hostname (set this to your own domain in the ignored .env file)
BASE_DOMAIN=example.com

# Homepage authentication and service widgets. Supply local values in .env.
HOMEPAGE_AUTH_SECRET=
HOMEPAGE_AUTH_PASSWORD=
ADGUARD_USERNAME=
ADGUARD_PASSWORD=
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=
JELLYFIN_API_KEY=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# SimpleSubGen
# Interval for periodic scans in minutes
SCANNER_INTERVAL=720

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# NLLB
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Languages
TARGET_LANGUAGES=en,bg
PREFERRED_AUDIO_LANGUAGE=en,fr,it,es,ja,de

# Workers
WORKERS=1

# Database
DATABASE_PATH=/data/simplesubgen.db

# Output
SUBTITLE_FORMAT=srt
SUBTITLE_SUFFIX=ai

# HF
HF_TOKEN=
