PUID=1000
PGID=1000
TZ=Europe/Sofia
DOWNLOADS_PATH=C:\Downloads
MOVIES_PATH=C:\Movies
TVSHOWS_PATH=C:\TV Shows

# SimpleSubGen
# Interval for periodic scans in minutes
SCANNER_INTERVAL=720

# Whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda

# NLLB
NLLB_MODEL=facebook/nllb-200-distilled-600M

# Languages
TARGET_LANGUAGES=en,bg
PREFERRED_AUDIO_LANGUAGE=en,fr,it,es,ja,de

# Workers
WORKERS=1

# Database
DATABASE_PATH=/data/simplesubgen.db

# Output
SUBTITLE_FORMAT=srt
SUBTITLE_SUFFIX=ai

# HF
HF_TOKEN=hf_***