PUID=1000
PGID=1000
TZ=Europe/Sofia
BASE_DOMAIN=example.com

SPEEDTEST_APP_KEY=APP_KEY
SPEEDTEST_TRACKER_ADMIN_PASSWORD=STRONG_PASSWORD
SPEEDTEST_TRACKER_ADMIN_EMAIL=admin@example.com

# Replace with an address assigned to the host's LAN interface.
SERVER_IP_ADDRESS=192.0.2.10

HOMELABLE_SECRET_KEY=STRONG_SECRET
HOMELABLE_AUTH_USERNAME=USERNAME
HOMELABLE_AUTH_PASSWORD_HASH='HASH'
HOMELABLE_HOMEPAGE_API_KEY=API_KEY

DATA_PATH=/srv/data
MOVIES_PATH=/srv/media/movies
TVSHOWS_PATH=/srv/media/tvshows

# Replace with the output of: stat -c '%g' /var/run/docker.sock
DOCKER_SOCK_GID=999

AUTOKUMA_KUMA_USERNAME=USERNAME
AUTOKUMA_KUMA_PASSWORD=STRONG_PASSWORD
