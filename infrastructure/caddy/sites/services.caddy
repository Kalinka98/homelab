budget.{$BASE_DOMAIN} {
    import common_headers
    reverse_proxy actual-budget:5006
}

home.{$BASE_DOMAIN} {
    import common_headers

    handle_path /quotes/* {
        header {
            -X-Frame-Options
            -Content-Security-Policy
            Content-Security-Policy "frame-ancestors 'self'"
        }

        reverse_proxy quotes-service:8000
    }

    handle {
        reverse_proxy homepage:3000
    }
}

vault.{$BASE_DOMAIN} {
    import common_headers

    reverse_proxy vaultwarden:80
}

cycle.{$BASE_DOMAIN} {
    reverse_proxy ovumcy:8080 {
        header_up X-Real-IP {remote_host}
    }
}

zimi.{$BASE_DOMAIN} {
    import common_headers

    header {
        -X-Frame-Options
        X-Frame-Options SAMEORIGIN
    }

    reverse_proxy zimi:8899
}

immich.{$BASE_DOMAIN} {
    import common_headers

    reverse_proxy immich-server:2283
}

dawarich.{$BASE_DOMAIN} {
    import common_headers

    reverse_proxy dawarich_app:3000
}
