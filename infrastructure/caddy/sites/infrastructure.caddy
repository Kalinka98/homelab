status.{$BASE_DOMAIN} {
    import private_proxy uptime-kuma:3001
}

speedtest.{$BASE_DOMAIN} {
    import private_proxy speedtest-tracker:80
}

logs.{$BASE_DOMAIN} {
    import private_proxy dozzle:8080
}


adguard.{$BASE_DOMAIN} {
    import private_proxy adguard:3000
}

monitor.{$BASE_DOMAIN} {
    import private_proxy beszel:8090
}

# Keep notifications working without VPN
notify.{$BASE_DOMAIN} {
    import common_headers
    reverse_proxy ntfy:80
}